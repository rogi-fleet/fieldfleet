# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Flutter/Dart specific
.dart_tool/
supabase/snippets/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
!build/web/
.flutter-plugins-dependencies
.metadata

# iOS/Mac specific
**/ios/**/Flutter/flutter_assets/
**/ios/**/Flutter/flutter_export_environment.sh
**/ios/**/Flutter/Generated.xcconfig
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/

# Android specific
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks

# Compiled outputs
*.dill
*.apk
*.aab
*.ipa
*.so
*.dylib

# IDE
.vscode/
.idea/
*.iml
*.ipr
*.iws

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store
**/._*

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
!site/assets/*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

analysis_output*.txt
backup.sql
*.backup

# Environment files with secrets
supabase/functions/.env

# Local build secrets
.env.local
dart-defines.env

supabase/.env.local
deployment/.env

# Local QA / Playwright / Claude Code artifacts.
# These live next to the repo for ad-hoc testing and should never be
# committed — `auth-state.json` in particular contains a live Supabase
# access token, and the `capture/check/find/login/...` js files are
# one-off scripts captured during interactive Playwright sessions.
.claude/skills/
.playwright/
.playwright-cli/
.playwright-mcp/
auth-state.json
auth-state*.json
bug-test/

# One-off Playwright/JS helper scripts used during interactive testing.
/capture-*.js
/check-*.js
/close-*.js
/do-*.js
/enable-*.js
/find-*.js
/hover-*.js
/inspect-*.js
/login-*.js
/navigate-*.js
/open-*.js
/press-*.js
/verify-*.js

# Deployment scratch (screenshots + nested playwright dirs).
deployment/.playwright-cli/
deployment/*.png

# Attached assets / reference PDFs — not for version control.
attached_assets/*.pdf

# Public sanitation: never commit local secrets, dumps, logs, or QA runtime artifacts.
nohup.out
deployment/*backup*.sql
deployment/auth_users_only.sql
deployment/data_restore_remaining.sql
deployment/backups/
*.dump
*.sql.gz
.claude/
qa/
*.env
.env
.env.*
!*.env.example
!deployment/.env.example
