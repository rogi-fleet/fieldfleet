# =============================================================================
# FieldFleet Supabase Configuration
# Copy to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Generate these for production
# -----------------------------------------------------------------------------

# Database password - generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your-super-secret-password-change-me

# JWT Secret - minimum 32 characters, generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# API Keys - generate at: https://supabase.com/docs/guides/self-hosting#api-keys
# Or use: npx @supabase/cli gen keys --jwt-secret "your-jwt-secret"
ANON_KEY=your-generated-anon-key
SERVICE_ROLE_KEY=your-generated-service-role-key

# -----------------------------------------------------------------------------
# REQUIRED: Your domains
# -----------------------------------------------------------------------------

# Where your API is hosted
API_EXTERNAL_URL=https://api.yourdomain.com
API_DOMAIN=api.yourdomain.com

# Where your Flutter app is hosted (for CORS)
SITE_URL=https://app.yourdomain.com

# Studio domain (admin dashboard)
STUDIO_DOMAIN=studio.yourdomain.com

# Allowed callback URLs (comma-separated)
URI_ALLOW_LIST=https://app.yourdomain.com,http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# REQUIRED: Email (using Resend)
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_ADMIN_EMAIL=noreply@yourdomain.com

# Also used by Edge Functions
RESEND_API_KEY=re_your_resend_api_key

# -----------------------------------------------------------------------------
# OPTIONAL: Google OAuth
# -----------------------------------------------------------------------------

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL: Stripe (for subscriptions)
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Database settings
# -----------------------------------------------------------------------------

POSTGRES_DB=postgres
POSTGRES_PORT=5432

# JWT expiry in seconds (default: 1 hour)
JWT_EXP=3600

# -----------------------------------------------------------------------------
# Storage settings
# -----------------------------------------------------------------------------

# Max file size in bytes (default: 200MB)
FILE_SIZE_LIMIT=209715200

# -----------------------------------------------------------------------------
# Port mappings (change if conflicts)
# -----------------------------------------------------------------------------

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
# Kong/nginx request size limit (set >= your largest expected upload)
KONG_CLIENT_MAX_BODY_SIZE=100m
STUDIO_PORT=3000

# -----------------------------------------------------------------------------
# Studio settings
# -----------------------------------------------------------------------------

STUDIO_ORG=FieldFleet
STUDIO_PROJECT=FieldFleet

# -----------------------------------------------------------------------------
# Optional: Disable signup (invite-only mode)
# -----------------------------------------------------------------------------

DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=false

# -----------------------------------------------------------------------------
# Secret key for Realtime (generate with: openssl rand -base64 64)
# -----------------------------------------------------------------------------

SECRET_KEY_BASE=replace-with-generated-secret-key-base
