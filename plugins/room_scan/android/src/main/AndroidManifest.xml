<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the room scanner's AR camera feed. The host app's
         manifest will merge this in. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ARCore is optional — devices without it should still install the
         host app. The plugin reports `engine: none` at runtime. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <application>
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>
</manifest>
